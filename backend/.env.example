# Copy this file to .env and fill in your Supabase values.

# Runtime DB connection used by FastAPI. Prefer the Supabase **Session pooler**
# (Connect dialog → "Session pooler", port 5432) or a direct connection.
# IMPORTANT: keep the +asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Direct connection used by Alembic migrations (Supabase → "Direct connection", port 5432).
# Also keep +asyncpg. Leave blank to reuse DATABASE_URL.
DIRECT_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Comma-separated allowed CORS origins (frontend dev + later your Vercel domain).
CORS_ORIGINS=http://localhost:4100

# Bearer token for admin write endpoints (Stage A). Leave blank for now.
ADMIN_TOKEN=

ENVIRONMENT=development
