# Frontend (Next.js). Copy to .env.local and adjust if needed.

# Base URL of the FastAPI backend.
# Local dev: the backend runs on port 8001.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Secret for the on-demand revalidate endpoint (POST /api/revalidate?secret=...).
# Set the same value in .env.local; call it after seeding/editing content.
REVALIDATE_SECRET=change-me
